    {
      "parameters": {
        "jsCode": "const h=$json.hourly||{}; const rain=(h.precipitation||[]).map(Number).filter(Number.isFinite); const prob=(h.precipitation_probability||[]).map(Number).filter(Number.isFinite); const temp=(h.temperature_2m||[]).map(Number).filter(Number.isFinite); const past=rain.slice(0,3),future=rain.slice(-3); const persistence=past.length?past.reduce((a,c)=>a+c,0)/past.length:0; const futureRain=future.length?future.reduce((a,c)=>a+c,0):0; const futureProb=prob.length?Math.max(...prob.slice(-3)):0; const trend=temp.length>=2?temp.at(-1)-temp[0]:0; const summary=(persistence>=.5||futureProb>=60)?'Recent precipitation / forecast probability suggests continued short-term wet conditions.':'No strong short-term precipitation persistence signal.'; return [{json:{experimental:true,horizon:'0-3 hours',precipitationPersistence:persistence,forecastPrecipitation3h:futureRain,peakRainProbability3h:futureProb,temperatureTrend:trend,summary,source:'Open-Meteo short-horizon data + WeatherGPT heuristic',warning:'Experimental heuristic - not an official forecast or trained meteorological model.'}}];"
      },
