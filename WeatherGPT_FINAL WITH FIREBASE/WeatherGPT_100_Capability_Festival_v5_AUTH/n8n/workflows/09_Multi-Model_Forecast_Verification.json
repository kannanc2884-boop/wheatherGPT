        "jsCode": "const pull=(name,node)=>{const j=$(node).first()?.json||{}; const rain=(j.hourly?.precipitation_probability||[]).filter(Number.isFinite); return {name,temperature:Number.isFinite(j.current?.temperature_2m)?j.current.temperature_2m:null,rainProbability:rain.length?Math.max(...rain):null,available:!j.error};}; const models=[pull('ECMWF IFS 0.25\u00b0','ECMWF IFS'),pull('NOAA GFS Seamless','GFS Seamless'),pull('DWD ICON Seamless','ICON Seamless')].filter(m=>m.temperature!=null||m.rainProbability!=null); const spread=a=>a.length?Math.max(...a)-Math.min(...a):null; const temps=models.map(x=>x.temperature).filter(Number.isFinite),rains=models.map(x=>x.rainProbability).filter(Number.isFinite); const t=spread(temps),r=spread(rains); const confidence=models.length<2?0:Math.max(0,Math.min(100,Math.round(100-(t||0)*8-(r||0)*.35))); return [{json:{models,availableModels:models.length,temperatureSpread:t,rainSpread:r,confidence,label:confidence>=80?'HIGH':confidence>=55?'MEDIUM':'LOW',source:'Open-Meteo explicit model selection',note:'Prototype model-agreement indicator, not formal probabilistic verification.'}}];"
