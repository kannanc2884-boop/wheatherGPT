        "jsCode": "const d=$json.daily||{}; const q=(d.river_discharge||[]).filter(Number.isFinite); const ensemble=(d.river_discharge_mean||[]).filter(Number.isFinite); const current=q[0]??null, peak=q.length?Math.max(...q):null, peakMean=ensemble.length?Math.max(...ensemble):null; const ratio=current&&peak!=null?peak/current:null; const level=ratio==null?'UNAVAILABLE':ratio>=2.5?'HIGH':ratio>=1.5?'ELEVATED':'LOW'; return [{json:{currentDischarge:current,peak7DayDischarge:peak,peakEnsembleMean:peakMean,peakToCurrentRatio:ratio,level,series:(d.time||[]).map((t,i)=>({date:t,riverDischarge:d.river_discharge?.[i]??null,ensembleMean:d.river_discharge_mean?.[i]??null})),source:'Open-Meteo Flood API / GloFAS',disclaimer:'Coarse river-discharge guidance; not a street-level flood warning.'}}];"
