{
  "name": "WeatherGPT 100 - Citizen Weather Reports",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "weathergpt-citizen",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "w6-1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "weathergpt-citizen"
    },
    {
      "parameters": {
        "jsCode": "const b=$json.body||$json; const store=$getWorkflowStaticData('global'); store.reports=store.reports||[]; if(b.action==='list') return [{json:{reports:store.reports.slice(-50).reverse(),official:false,disclaimer:'Citizen reports are unverified community observations.'}}]; const report={id:Date.now(),time:new Date().toISOString(),location:b.location||'Unknown',type:b.type||'Weather observation',severity:b.severity||'info',note:(b.note||'').slice(0,300),verified:false}; store.reports.push(report); return [{json:{ok:true,report,official:false}}];"
      },
      "id": "w6-2",
      "name": "Process",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
